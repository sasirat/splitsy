# Copy to .env and fill in. Never commit .env.

# Neon (dev branch) — Dashboard → Connect.
# Pooled URL (host contains "-pooler"): used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct, unpooled URL: used by the Prisma CLI (migrate, studio).
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Clerk (Google sign-in) — Dashboard → Configure → API keys (Next.js).
# Development instances use pk_test_/sk_test_ keys and Clerk's shared Google credentials.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
